{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "NEAR AI",
  "description": "Documentation for NEAR AI Cloud: private, verifiable AI inference in Trusted Execution Environments through an OpenAI-compatible API.",
  "colors": {
    "primary": "#0B8FF6",
    "light": "#83D2FA",
    "dark": "#0B8FF6"
  },
  "logo": {
    "light": "/logo/nearAI-logo.svg",
    "dark": "/logo/nearAI-logo.svg",
    "href": "/"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "background": {
    "color": {
      "light": "#000000",
      "dark": "#000000"
    }
  },
  "styling": {
    "codeblocks": "dark"
  },
  "navigation": {
    "groups": [
      {
        "group": "Get Started",
        "pages": ["index", "cloud/introduction", "cloud/quickstart"]
      },
      {
        "group": "Models",
        "icon": "/images/icons/ai.svg",
        "pages": ["cloud/models", "cloud/reasoning-models"]
      },
      {
        "group": "Private Inference",
        "pages": [
          "cloud/private-inference",
          {
            "group": "Verification",
            "icon": "/images/icons/verification.svg",
            "root": "cloud/verification/index",
            "pages": [
              "cloud/verification/model",
              "cloud/verification/gateway",
              "cloud/verification/tls",
              "cloud/verification/chat"
            ]
          }
        ]
      },
      {
        "group": "Guides",
        "icon": "/images/icons/docs.svg",
        "pages": [
          "cloud/guides/openai-compatibility",
          "cloud/guides/usage-reporting",
          {
            "group": "Integrations",
            "root": "cloud/guides/integrations/index",
            "expanded": true,
            "pages": [
              "cloud/guides/integrations/model-discovery",
              {
                "group": "Coding Agents and IDEs",
                "expanded": true,
                "pages": [
                  "cloud/guides/integrations/cursor",
                  "cloud/guides/integrations/continue",
                  "cloud/guides/integrations/cline-roo-kilo",
                  "cloud/guides/integrations/aider-zed",
                  "cloud/guides/opencode-goose"
                ]
              },
              {
                "group": "Self-hosted and Team Apps",
                "expanded": true,
                "pages": [
                  "cloud/guides/integrations/librechat",
                  "cloud/guides/integrations/open-webui",
                  "cloud/guides/integrations/litellm",
                  "cloud/guides/integrations/dify"
                ]
              }
            ]
          },
          "cloud/guides/prompt-caching",
          "cloud/guides/fusion",
          "cloud/guides/web-search",
          "cloud/guides/specialized-endpoints",
          "cloud/guides/e2ee-chat-completions"
        ]
      },
      {
        "group": "Reference",
        "pages": ["api"]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Developer Dashboard",
        "href": "https://cloud.near.ai"
      }
    ],
    "primary": {
      "type": "github",
      "href": "https://github.com/nearai/docs"
    }
  },
  "footer": {
    "socials": {
      "telegram": "https://t.me/nearaialpha",
      "x": "https://x.com/near_ai",
      "github": "https://github.com/nearai/docs"
    },
    "links": [
      {
        "header": "Docs",
        "items": [
          { "label": "Quickstart", "href": "https://docs.near.ai/cloud/quickstart" },
          { "label": "Models", "href": "https://docs.near.ai/cloud/models" },
          { "label": "Private Inference", "href": "https://docs.near.ai/cloud/private-inference" },
          { "label": "Verification", "href": "https://docs.near.ai/cloud/verification" },
          { "label": "API Reference", "href": "https://docs.near.ai/api" }
        ]
      },
      {
        "header": "Community",
        "items": [
          { "label": "Telegram", "href": "https://t.me/nearaialpha" },
          { "label": "X", "href": "https://x.com/near_ai" }
        ]
      },
      {
        "header": "More",
        "items": [
          { "label": "Developer Dashboard", "href": "https://cloud.near.ai" },
          { "label": "GitHub", "href": "https://github.com/nearai/docs" }
        ]
      }
    ]
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
  "seo": {
    "metatags": {
      "og:site_name": "NEAR AI Docs",
      "og:image": "https://docs.near.ai/images/icons/social-card.png",
      "twitter:card": "summary_large_image",
      "twitter:image": "https://docs.near.ai/images/icons/social-card.png"
    }
  }
}
